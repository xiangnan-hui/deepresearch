# ==================== 前端基础配置 ====================
# 复制本文件为 .env 并按需修改（.env 已被 .gitignore 排除，不会提交）

# 应用标题
VITE_TITLE=行业咨询助手

# 后端 API 基础地址（前端通过 Vite 代理转发到 VITE_API_PROXY）
VITE_API_BASE=http://localhost:8000/

# 后端 API 代理目标（与 backend/.env 中的 APP_HOST/APP_PORT 对应）
VITE_API_PROXY=http://localhost:8000/
